MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Dialogues_es
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: es
  m_SharedData: {fileID: 11400000, guid: dbcfa153334420642a74bbaaf4718f82, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 11973013504
    m_Localized: "\xA1Ay! \xA1Ay, ay! \xA1No me aplastes, por favor! Soy\u2026 soy
      amistoso. Creo. Bueno, eso dicen. Bueno, lo digo yo. Que tampoco soy la fuente
      m\xE1s fiable. Perdona."
    m_Metadata:
      m_Items: []
  - m_Id: 277950607360
    m_Localized: "\xBFD\xF3nde estoy?"
    m_Metadata:
      m_Items: []
  - m_Id: 11487085314027520
    m_Localized: Bienvenido
    m_Metadata:
      m_Items: []
  - m_Id: 11500370767753216
    m_Localized: "Esa es\u2026 una pregunta muy buena. Muy, muy buena. No tengo respuesta.
      Perdona. "
    m_Metadata:
      m_Items: []
  - m_Id: 11856825014398976
    m_Localized: "\xBFY c\xF3mo se sale?"
    m_Metadata:
      m_Items: []
  - m_Id: 11857092103483392
    m_Localized: "Eso creo que s\xED lo s\xE9. Los bloques flotan, y si algo los
      golpea con fuerza se rompen. Si los rompemos todos, creo que encontraremos
      la salida. "
    m_Metadata:
      m_Items: []
  - m_Id: 11856143909761024
    m_Localized: "Lo que s\xED s\xE9 es que llevamos tiempo atrapados aqu\xED. Digo
      \xABllevamos\xBB porque ahora t\xFA tambi\xE9n est\xE1s atrapado. Perdona por
      eso tambi\xE9n."
    m_Metadata:
      m_Items: []
  - m_Id: 11863475901280256
    m_Localized: "Tengo una pala, una bola y algo de magia. No mucha. Bueno, poca.
      \xBFMe ayudas?"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
